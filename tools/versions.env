# tools/versions.env — single source of truth for gate tool versions (WF-02).
#
# Plain KEY=value lines only: no quotes, no spaces, no shell logic, so it can
# be sourced by bash and parsed by simple regex tools (e.g. Renovate).
#
# Read by:
#   - scripts/install-tools.sh   (installs gosec + govulncheck at these pins)
#   - scripts/check-go-version.sh (drift guard: go.work, go.mod files,
#                                  .github/workflows/ci.yml, Dockerfiles)
#   - .githooks/pre-push          (the gate; exports GOTOOLCHAIN=go$GO_VERSION)
#   - .github/workflows/ci.yml    (via the two scripts above)
#
# To bump a tool, edit only this file (plus, for GO_VERSION, the go.mod /
# ci.yml / Dockerfile lines the drift guard then reports).
# See docs/CI_CD_AND_HOOKS.md.
GO_VERSION=1.26.9
GOSEC_VERSION=v2.29.0
GOSEC_XTOOLS_VERSION=v0.50.0
GOVULNCHECK_VERSION=v1.8.0
