migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Flutter test golden-failure artifacts (generated on mismatch)
test/failures/
test/**/failures/

# Firebase client config (PUSH-FCM): per-project, never committed. CI writes
# android/app/google-services.json from the GOOGLE_SERVICES_JSON_B64 secret;
# see docs/PUSH.md.
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
