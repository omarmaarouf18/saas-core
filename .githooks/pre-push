#!/bin/bash
set -e
echo "== pre-push gate: running checks =="

# 1. Verify Go formatting
UNFORMATTED=$(gofmt -l . 2>&1)
if [ -n "$UNFORMATTED" ]; then
  echo "BLOCKED: gofmt found unformatted files:"
  echo "$UNFORMATTED"
  exit 1
fi

# 2. Verify Dart formatting
if [ -d "frontend" ]; then
  echo "-- checking frontend Dart formatting --"
  UNFORMATTED_DART=$(cd frontend && dart format --output=none --set-exit-if-changed lib/ 2>&1) || {
    echo "BLOCKED: dart format found unformatted files:"
    echo "$UNFORMATTED_DART"
    exit 1
  }
fi

# 3. Verify Markdown Commit SHAs
FAILED_SHA=0
CITATION_PATTERN="(Commit SHA|Commit:|Related Commit SHA|Fix Commit SHA|\(Commit )"

for file in $(find . -type f -name "*.md" -not -path "*/node_modules/*" -not -path "*/vendor/*" -not -path "*/.git/*"); do
  for sha in $(grep -iE "$CITATION_PATTERN" "$file" | grep -oE "[0-9a-f]{40}" || true); do
    if ! git cat-file -e "$sha^{commit}" 2>/dev/null; then
      echo "BLOCKED: fabricated/non-existent SHA $sha in $file"
      FAILED_SHA=1
    fi
  done

  for sha in $(grep -v -iE "$CITATION_PATTERN" "$file" | grep -oE "[0-9a-f]{40}" || true); do
    if ! git cat-file -e "$sha^{commit}" 2>/dev/null; then
      echo "WARNING: possible unlinked/fabricated-looking hash $sha in $file (not on a recognized citation line — verify manually if this was meant to be a commit reference)"
    fi
  done
done

PREV_COMMIT="HEAD~1"
if git rev-parse --verify "$PREV_COMMIT" >/dev/null 2>&1; then
  NEW_SHAS=$(git diff "$PREV_COMMIT" HEAD -- "docs/changelog/*.md" | grep -E "^\+[[:space:]]*- \*\*Commit SHA\*\*" | grep -oE "[0-9a-f]{40}" || true)
  for sha in $NEW_SHAS; do
    if ! git cat-file -e "$sha^{commit}" 2>/dev/null; then
      echo "BLOCKED: Newly added changelog commit SHA $sha does not exist in Git history"
      FAILED_SHA=1
    elif ! git merge-base --is-ancestor "$sha" HEAD 2>/dev/null; then
      echo "BLOCKED: Newly added changelog commit SHA $sha is not in current branch history"
      FAILED_SHA=1
    fi
  done
fi

if [ "$FAILED_SHA" -eq 1 ]; then
  exit 1
fi

# 4. Verify Go version consistency (drift guard)
echo "-- checking Go version consistency across go.work, go.mod, ci.yml, and Dockerfiles --"
CANONICAL_GO_VERSION="1.26"
DRIFT_FAILED=0

for f in go.work services/*/go.mod shared/infra/go.mod tools/docgen/go.mod; do
  if [ -f "$f" ]; then
    v=$(grep -E '^go [0-9]+\.[0-9]+' "$f" | head -n 1 | awk '{print $2}')
    if [ "$v" != "$CANONICAL_GO_VERSION" ]; then
      echo "BLOCKED: Go version drift in $f: expected $CANONICAL_GO_VERSION, found '${v:-NONE}'"
      DRIFT_FAILED=1
    fi
  fi
done

if [ -f ".github/workflows/ci.yml" ]; then
  for v in $(grep -oE "go-version: '[0-9]+\.[0-9]+'" .github/workflows/ci.yml | grep -oE "[0-9]+\.[0-9]+"); do
    if [ "$v" != "$CANONICAL_GO_VERSION" ]; then
      echo "BLOCKED: Go version drift in .github/workflows/ci.yml: expected $CANONICAL_GO_VERSION, found '$v'"
      DRIFT_FAILED=1
    fi
  done
fi

for d in services/*/Dockerfile; do
  if [ -f "$d" ]; then
    for v in $(grep -oE "FROM golang:[0-9]+\.[0-9]+" "$d" | grep -oE "[0-9]+\.[0-9]+"); do
      if [ "$v" != "$CANONICAL_GO_VERSION" ]; then
        echo "BLOCKED: Go version drift in $d: expected $CANONICAL_GO_VERSION, found '$v'"
        DRIFT_FAILED=1
      fi
    done
  fi
done

if [ "$DRIFT_FAILED" -eq 1 ]; then
  exit 1
fi

# 5. Resolve security check binaries (gosec & govulncheck)
GOSEC_BIN=$(which gosec 2>/dev/null || ls ~/go/bin/gosec 2>/dev/null || echo "")
if [ -z "$GOSEC_BIN" ] && [ -d "$HOME/go/bin" ]; then
  GOSEC_BIN="$HOME/go/bin/gosec"
fi

GOVULNCHECK_BIN=$(which govulncheck 2>/dev/null || ls ~/go/bin/govulncheck 2>/dev/null || echo "")
if [ -z "$GOVULNCHECK_BIN" ] && [ -d "$HOME/go/bin" ]; then
  GOVULNCHECK_BIN="$HOME/go/bin/govulncheck"
fi

for mod in services/api-gateway services/auth-service services/chat-service \
           services/notification-service services/user-service shared/infra; do
  echo "-- checking $mod --"
  
  # Go Build, Vet, Test parity
  (cd "$mod" && go build ./... && go vet ./... && go test ./... -count=1) || {
    echo "BLOCKED: $mod failed build/vet/test"
    exit 1
  }

  # govulncheck check parity
  # NOTE: We run govulncheck but filter out standard library ("stdlib") vulnerabilities locally.
  # We also filter for vulnerabilities that are actually called (where the trace contains a package starting
  # with "github.com/project/"), to prevent blocking on uncalled module-level dependencies that do not impact
  # the compiled binary.
  # If a standard library vulnerability is skipped, we print a loud warning highlighting the skipped GO-ID.
  if [ -z "$GOVULNCHECK_BIN" ] || [ ! -x "$GOVULNCHECK_BIN" ]; then
    echo "govulncheck not found, installing..."
    go install golang.org/x/vuln/cmd/govulncheck@latest 2>/dev/null || true
    GOVULNCHECK_BIN="$HOME/go/bin/govulncheck"
  fi
  if [ -x "$GOVULNCHECK_BIN" ]; then
    echo "-- running govulncheck on $mod --"
    VULN_OUT=$( (cd "$mod" && "$GOVULNCHECK_BIN" -format json ./...) || true)
    
    # Check for stdlib vulnerabilities to print loud warnings
    STDLIB_VULNS=$(echo "$VULN_OUT" | jq -r 'select(.finding != null and (.finding.trace | any(.package != null and (.package | startswith("github.com/project/")))) and .finding.trace[0].module == "stdlib") | .finding.osv' | sort -u)
    if [ -n "$STDLIB_VULNS" ]; then
      for id in $STDLIB_VULNS; do
        echo "WARNING: SKIPPED ($id) (stdlib vulnerability) — verify local Go patch version"
      done
    fi

    # Block on active third-party dependencies vulnerabilities
    NON_STDLIB_VULNS=$(echo "$VULN_OUT" | jq -c 'select(.finding != null and (.finding.trace | any(.package != null and (.package | startswith("github.com/project/")))) and .finding.trace[0].module != "stdlib")')
    if [ -n "$NON_STDLIB_VULNS" ]; then
      echo "BLOCKED: $mod failed govulncheck security scan with third-party vulnerabilities:"
      echo "$NON_STDLIB_VULNS" | jq .
      exit 1
    fi
  else
    echo "BLOCKED: govulncheck is required but could not be installed/found. Install via: go install golang.org/x/vuln/cmd/govulncheck@latest"
    exit 1
  fi

  # gosec check parity
  if [ -z "$GOSEC_BIN" ] || [ ! -x "$GOSEC_BIN" ]; then
    echo "gosec not found, installing..."
    go install github.com/securego/gosec/v2/cmd/gosec@latest 2>/dev/null || true
    GOSEC_BIN="$HOME/go/bin/gosec"
  fi
  if [ -x "$GOSEC_BIN" ]; then
    echo "-- running gosec on $mod --"
    (cd "$mod" && "$GOSEC_BIN" ./...) || {
      echo "BLOCKED: $mod failed gosec security scan"
      exit 1
    }
  else
    echo "BLOCKED: gosec is required but could not be installed/found. Install via: go install github.com/securego/gosec/v2/cmd/gosec@latest"
    exit 1
  fi
done

# 5. Flutter analyze & test checks parity (strict without ignoring warnings/infos)
if [ -d "frontend" ]; then
  echo "-- checking frontend Flutter analyze/test --"
  (cd frontend && flutter analyze && flutter test) || {
    echo "BLOCKED: frontend failed analyze or test checks"
    exit 1
  }
fi

echo "== pre-push gate: all checks passed =="
