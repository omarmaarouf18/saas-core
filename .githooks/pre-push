#!/bin/bash
set -e

# Git exports GIT_DIR=. into hook environments; the Flutter tool misreads it
# and fails package resolution ("Flutter SDK is not available"). Sanitize.
# (Also required before the agent push guard below reads the real git dir.)
unset GIT_DIR GIT_WORK_TREE

# ---------------------------------------------------------------------------
# WF-01 agent push guard (Layer B) — must run before any other check.
#
# Layer A is the per-worktree remote.origin.pushurl that
# scripts/agent-worktree.sh sets in every agent worktree, which fails
# `git push origin` there. This layer independently blocks ANY real push made
# from a linked worktree or from an agent/* branch — including pushes to other
# remotes (e.g. a throwaway local bare remote) — because agents never push:
# the owner merges each agent branch into the integration branch and pushes
# from the main worktree. See docs/WORKFLOW.md.
#
# This script is also the `make check` / `make ci` / `make ci-full` gate,
# which invokes it WITHOUT arguments; git always invokes a pre-push hook with
# at least the remote name as $1, so the guard only fires for real hook
# invocations.
# ---------------------------------------------------------------------------
if [ "${1:-}" != "" ]; then
  HOOK_GIT_DIR=$(git rev-parse --git-dir)
  HOOK_BRANCH=$(git rev-parse --abbrev-ref HEAD)
  case "$HOOK_GIT_DIR" in
    */worktrees/*)
      echo "BLOCKED: agents never push; the owner merges and pushes from the main worktree"
      exit 1
      ;;
  esac
  case "$HOOK_BRANCH" in
    agent/*)
      echo "BLOCKED: agents never push; the owner merges and pushes from the main worktree"
      exit 1
      ;;
  esac
fi
# --- end WF-01 agent push guard ---

# ---------------------------------------------------------------------------
# WF-02 delete-only push: when EVERY ref line git passes on stdin
# ("<local ref> <local sha> <remote ref> <remote sha>") has an all-zero local
# sha, the push only deletes remote refs and publishes no code, so the gate is
# skipped. Runs AFTER the agent push guard (agents still cannot delete) and
# only for real pushes ($1 set); `make check` never reads stdin.
# WF-03: the ref lines are kept in PUSH_LINES for the scope computation.
# ---------------------------------------------------------------------------
PUSH_LINES=""
if [ "${1:-}" != "" ]; then
  PUSH_LINES=$(cat)
  REF_LINES=0
  NON_DELETE=0
  while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ -n "${_local_ref}${local_sha}" ] || continue
    REF_LINES=$((REF_LINES + 1))
    case "$local_sha" in
      *[!0]* | "") NON_DELETE=1 ;;
    esac
  done <<<"$PUSH_LINES"
  if [ "$REF_LINES" -gt 0 ] && [ "$NON_DELETE" -eq 0 ]; then
    echo "delete-only push: gate skipped"
    exit 0
  fi
fi

# ---------------------------------------------------------------------------
# WF-03 scope: which stages this run needs (scripts/changed-scope.sh prints
# the scope and why). A real push is scoped by the pushed commit range; a
# run without arguments (`make check` / `make ci`) by the working tree vs the
# merge-base with logic-exploitation. CI_SCOPE=full (`make ci-full`) forces
# the full gate. GitHub CI (.github/workflows/ci.yml) always runs everything.
# ---------------------------------------------------------------------------
# WF-03 pass stamp: a run without arguments records the tree it checks
# (computed BEFORE the scope, see scripts/gate-stamp.sh) and, if every stage
# passes and the tree did not change meanwhile, stamps it for `make commit`.
STAMP_TREE=""
if [ "${1:-}" != "" ]; then
  SCOPE_OUT=$(bash scripts/changed-scope.sh --push <<<"$PUSH_LINES")
else
  STAMP_TREE=$(bash scripts/gate-stamp.sh tree)
  SCOPE_OUT=$(bash scripts/changed-scope.sh)
fi
eval "$SCOPE_OUT"
if [ "$SCOPE_MODE" = "none" ]; then
  echo "== pre-push gate: nothing changed, no checks to run =="
  exit 0
fi

# ---------------------------------------------------------------------------
# CI lock (WF-02, narrowed in WF-03): only the stages that use the shared
# local Mongo/Redis — integration test packages, see scripts/go-test-module.sh
# — run under flock on <git-common-dir>/ci.lock (scripts/ci-lock.sh). gofmt,
# vet, gosec, govulncheck, gitleaks, flutter and unit tests run without it,
# so parallel worktrees overlap everywhere else. A caller that already holds
# the lock sets CI_LOCK_HELD=1.
# ---------------------------------------------------------------------------
# Per-run suffix for test DB names / Redis keys: <worktree dir name>-<pid>,
# characters outside [A-Za-z0-9_-] become "_" (Mongo DB names cannot contain
# spaces). An explicit TEST_DB_SUFFIX wins.
if [ -z "${TEST_DB_SUFFIX:-}" ]; then
  TEST_DB_SUFFIX="$(basename "$(git rev-parse --show-toplevel)" | tr -c 'A-Za-z0-9_\n-' '_')-$$"
fi
export TEST_DB_SUFFIX
echo "TEST_DB_SUFFIX=$TEST_DB_SUFFIX"

echo "== pre-push gate: running checks (scope: $SCOPE_KEY) =="

# WF-03 per-stage timing: every stage prints "[timing] <stage> <seconds>s".
GATE_T0=$EPOCHREALTIME
STAGE_NAME=""
STAGE_T0=""
stage_begin() {
  STAGE_NAME="$1"
  STAGE_T0=$EPOCHREALTIME
}
stage_end() {
  awk -v a="$STAGE_T0" -v b="$EPOCHREALTIME" -v n="$STAGE_NAME" 'BEGIN { printf "[timing] %s %.1fs\n", n, b - a }'
}

# Pin the Go toolchain for the whole gate to GO_VERSION from
# tools/versions.env: a local Go that differs (or a distro build) makes the go
# command download and use the official toolchain instead.
. tools/versions.env
export GOTOOLCHAIN="go${GO_VERSION}"
echo "-- Go toolchain: GOTOOLCHAIN=$GOTOOLCHAIN ($(go version)) --"

# Set default authenticated Mongo & Redis URIs for host-level unit/integration tests
export MONGO_URI="${MONGO_URI:-mongodb://root:devpassword123@localhost:27017/saas_platform?authSource=admin}"
export REDIS_URI="${REDIS_URI:-redis://:devpassword123@localhost:6380}"


# An explicit GOVULNCHECK_BIN in the environment overrides the pinned binary
# (used to test the gate's error handling, e.g. GOVULNCHECK_BIN=/bin/false).
GOVULNCHECK_BIN_OVERRIDE="${GOVULNCHECK_BIN:-}"

# Resolve the pinned gate tools (gosec, govulncheck, gitleaks).
# Versions come only from tools/versions.env; scripts/install-tools.sh builds
# them once into a versioned cache and reuses the cached binaries without
# network access. CI uses the same script. No @latest fallback, no skipping.
stage_begin install-tools
TOOLS_OUT=$(bash scripts/install-tools.sh) || {
  echo "BLOCKED: scripts/install-tools.sh could not install the pinned gate tools (see tools/versions.env)"
  exit 1
}
GOSEC_BIN=$(printf '%s\n' "$TOOLS_OUT" | sed -n 's/^GOSEC_BIN=//p')
GOVULNCHECK_BIN=$(printf '%s\n' "$TOOLS_OUT" | sed -n 's/^GOVULNCHECK_BIN=//p')
GITLEAKS_BIN=$(printf '%s\n' "$TOOLS_OUT" | sed -n 's/^GITLEAKS_BIN=//p')
if [ ! -x "$GOSEC_BIN" ] || [ ! -x "$GOVULNCHECK_BIN" ] || [ ! -x "$GITLEAKS_BIN" ]; then
  echo "BLOCKED: scripts/install-tools.sh did not report executable gosec/govulncheck/gitleaks binaries:"
  echo "$TOOLS_OUT"
  exit 1
fi
if [ -n "$GOVULNCHECK_BIN_OVERRIDE" ]; then
  echo "NOTE: GOVULNCHECK_BIN overridden from the environment: $GOVULNCHECK_BIN_OVERRIDE (pinned: $GOVULNCHECK_BIN)"
  GOVULNCHECK_BIN="$GOVULNCHECK_BIN_OVERRIDE"
fi
echo "-- security tools: $GOVULNCHECK_BIN, $GOSEC_BIN, $GITLEAKS_BIN --"
stage_end

# 0. Secret scan (WF-03): gitleaks over the change only — the pushed commit
# range on a real push, otherwise merge-base..HEAD plus staged, unstaged and
# untracked files. Values are always redacted (scripts/gitleaks-scan.sh).
stage_begin gitleaks
if [ "${1:-}" != "" ]; then
  while read -r _lref lsha _rref rsha; do
    [ -n "${_lref}${lsha}" ] || continue
    case "$lsha" in *[!0]*) ;; *) continue ;; esac # delete line
    from="$rsha"
    case "$rsha" in
      *[!0]*) ;;
      *)
        # New remote ref: scan from its merge-base with the integration branch.
        from=""
        for cand in origin/logic-exploitation logic-exploitation; do
          if git rev-parse --verify --quiet "$cand^{commit}" >/dev/null; then
            from=$(git merge-base "$lsha" "$cand")
            break
          fi
        done
        ;;
    esac
    GITLEAKS_BIN="$GITLEAKS_BIN" bash scripts/gitleaks-scan.sh range "$from" "$lsha" || exit 1
  done <<<"$PUSH_LINES"
else
  GITLEAKS_BIN="$GITLEAKS_BIN" bash scripts/gitleaks-scan.sh worktree "${SCOPE_BASE:-logic-exploitation}" || exit 1
fi
stage_end

# 0b. Script regression tests (FE-APK-CHANNEL): every run, they take well
# under a second. scripts/test_changed_scope.sh guards the scope script this
# gate depends on (the FE-CLEANUP SIGPIPE exit 141 on long diffs);
# scripts/test_apk_channel.sh keeps the website download and the in-app
# update on the same universal APK.
stage_begin script-tests
for t in scripts/test_changed_scope.sh scripts/test_apk_channel.sh; do
  echo "-- $t --"
  bash "$t" || {
    echo "BLOCKED: $t failed"
    exit 1
  }
done
stage_end

# 1. Verify Go formatting: the whole repo on a full run, otherwise the
# scoped module directories (plus tests/contracts when in scope).
if [ "$SCOPE_MODE" = "full" ] || [ -n "$SCOPE_GO_MODULES" ] || [ "$SCOPE_CONTRACTS" = 1 ]; then
  stage_begin gofmt
  if [ "$SCOPE_MODE" = "full" ]; then
    GOFMT_DIRS="."
  else
    GOFMT_DIRS="$SCOPE_GO_MODULES"
    [ "$SCOPE_CONTRACTS" != 1 ] || GOFMT_DIRS="$GOFMT_DIRS tests/contracts"
  fi
  # shellcheck disable=SC2086 # word splitting is intended (module dirs)
  UNFORMATTED=$(gofmt -l $GOFMT_DIRS 2>&1)
  if [ -n "$UNFORMATTED" ]; then
    echo "BLOCKED: gofmt found unformatted files:"
    echo "$UNFORMATTED"
    exit 1
  fi
  stage_end
fi

# 2. Verify Dart formatting
if [ "$SCOPE_FRONTEND" = 1 ] && [ -d "frontend" ]; then
  stage_begin dart-format
  echo "-- checking frontend Dart formatting --"
  UNFORMATTED_DART=$(cd frontend && dart format --output=none --set-exit-if-changed lib/ 2>&1) || {
    echo "BLOCKED: dart format found unformatted files:"
    echo "$UNFORMATTED_DART"
    exit 1
  }
  stage_end
fi

# 3. Verify Markdown Commit SHAs
if [ "$SCOPE_DOCS" = 1 ]; then
  stage_begin md-sha
  FAILED_SHA=0

  for file in $(find . -type f -name "*.md" -not -path "*/node_modules/*" -not -path "*/vendor/*" -not -path "*/.git/*"); do
    for sha in $(grep -oE "[0-9a-f]{40}" "$file" || true); do
      if ! git cat-file -e "$sha^{commit}" 2>/dev/null; then
        echo "BLOCKED: fabricated/non-existent SHA $sha in $file"
        FAILED_SHA=1
      elif ! git merge-base --is-ancestor "$sha" HEAD 2>/dev/null; then
        echo "BLOCKED: SHA $sha in $file is not reachable from current branch history"
        FAILED_SHA=1
      fi
    done
  done

  if [ "$FAILED_SHA" -eq 1 ]; then
    exit 1
  fi
  stage_end
fi

# 4. Verify Go version consistency (drift guard). The canonical version is
# GO_VERSION in tools/versions.env (also exported as GOTOOLCHAIN above); the
# script checks go.work, every go.mod, ci.yml and the Dockerfiles against it.
# Runs whenever a Go module is in scope (a services/<svc>/Dockerfile change
# is a module change).
if [ "$SCOPE_MODE" = "full" ] || [ -n "$SCOPE_GO_MODULES" ]; then
  stage_begin go-drift
  echo "-- checking Go version consistency across go.work, go.mod, ci.yml, and Dockerfiles --"
  bash scripts/check-go-version.sh || exit 1
  stage_end
fi

# 5. Per-module Go build, vet, test and security scans.
if [ -n "$SCOPE_GO_MODULES" ]; then

  for mod in $SCOPE_GO_MODULES; do
    echo "-- checking $mod --"

    # Go Build, Vet, Test parity. WF-03: scripts/go-test-module.sh runs unit
    # packages from the Go test cache and integration packages (those that
    # link a Mongo/Redis client) always, with -count=1.
    stage_begin "go-build-vet-test:$mod"
    (cd "$mod" && go build ./... && go vet ./...) || {
      echo "BLOCKED: $mod failed build/vet"
      exit 1
    }
    bash scripts/go-test-module.sh "$mod" || {
      echo "BLOCKED: $mod failed test"
      exit 1
    }
    stage_end

    # govulncheck: scripts/govulncheck-module.sh blocks on govulncheck errors
    # (exit code other than 0/3, or no valid JSON config message) and on called
    # third-party findings; called stdlib findings only warn (policy unchanged).
    stage_begin "govulncheck:$mod"
    GOVULNCHECK_BIN="$GOVULNCHECK_BIN" bash scripts/govulncheck-module.sh "$mod" || exit 1
    stage_end

    # gosec check parity
    echo "-- running gosec on $mod --"
    stage_begin "gosec:$mod"
    (cd "$mod" && "$GOSEC_BIN" ./...) || {
      echo "BLOCKED: $mod failed gosec security scan"
      exit 1
    }
    stage_end
  done
fi

# 5b. shared/infra tests for a docs change (changelog and docgen validation
# live there) when shared/infra is not already a scoped module.
if [ "$SCOPE_INFRA_TESTS" = 1 ]; then
  case " $SCOPE_GO_MODULES " in
    *" shared/infra "*) ;;
    *)
      echo "-- running shared/infra tests (docs scope) --"
      stage_begin "go-test:shared/infra"
      bash scripts/go-test-module.sh shared/infra || {
        echo "BLOCKED: shared/infra tests failed"
        exit 1
      }
      stage_end
      ;;
  esac
fi

# 5c. shared/infra/docgen tests read service handlers and frontend/** (route
# map, STATUS.md coverage, widget counts), so service/frontend changes run
# them even when shared/infra itself is not in scope.
if [ "$SCOPE_DOCGEN" = 1 ] && [ "$SCOPE_INFRA_TESTS" != 1 ]; then
  case " $SCOPE_GO_MODULES " in
    *" shared/infra "*) ;;
    *)
      echo "-- running shared/infra/docgen tests --"
      stage_begin "go-test:shared/infra/docgen"
      bash scripts/go-test-module.sh shared/infra ./docgen/... || {
        echo "BLOCKED: shared/infra/docgen tests failed"
        exit 1
      }
      stage_end
      ;;
  esac
fi

# 6. Run In-Process API Contract Tests (Phase 4 / QA-GAP-02)
# Runs in-process in milliseconds without Docker Compose, validating inter-service
# schema alignment, AST field tags, and strict JSON deserialization across all microservices.
if [ "$SCOPE_CONTRACTS" = 1 ]; then
  stage_begin contracts
  echo "-- running in-process API contract tests (tests/contracts) --"
  (cd tests/contracts && go test -v -count=1 ./...) || {
    echo "BLOCKED: tests/contracts failed API contract validation"
    exit 1
  }
  stage_end
fi

# 7. Compose stack validation (scripts/compose-validate.sh; placeholders, no
# secrets) for the touched stack(s).
if [ -n "$SCOPE_COMPOSE" ]; then
  stage_begin compose
  echo "-- validating compose stacks: $SCOPE_COMPOSE --"
  # shellcheck disable=SC2086 # word splitting is intended (stack names)
  bash scripts/compose-validate.sh $SCOPE_COMPOSE || exit 1
  stage_end
fi

# 8. Frontend composition-layer gate (blocks Scaffold(/AppBar(/BoxDecoration(/Color(0xFF/.toUpperCase() in screens/)
if [ "$SCOPE_FRONTEND" = 1 ] && [ -d "frontend" ]; then
  stage_begin frontend-composition
  echo "-- checking frontend composition gate --"
  bash scripts/frontend_composition_gate.sh || {
    echo "BLOCKED: frontend composition gate failed"
    exit 1
  }
  stage_end
fi

# 9. Flutter analyze & test checks parity (strict without ignoring warnings/infos)
if [ "$SCOPE_FRONTEND" = 1 ] && [ -d "frontend" ]; then
  stage_begin flutter-analyze-test
  echo "-- checking frontend Flutter analyze/test --"
  (cd frontend && flutter analyze && flutter test) || {
    echo "BLOCKED: frontend failed analyze or test checks"
    exit 1
  }
  stage_end
fi

awk -v a="$GATE_T0" -v b="$EPOCHREALTIME" 'BEGIN { printf "[timing] total %.1fs\n", b - a }'
echo "== pre-push gate: all checks passed (scope: $SCOPE_KEY) =="

if [ -n "$STAMP_TREE" ]; then
  if [ "$(bash scripts/gate-stamp.sh tree)" = "$STAMP_TREE" ]; then
    bash scripts/gate-stamp.sh write "$STAMP_TREE" "$SCOPE_KEY"
  else
    echo "WARNING: files changed while the gate ran; no stamp written. Run make check again before make commit."
  fi
fi
