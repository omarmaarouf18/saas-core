{
    auto_https off
    admin off
}

# API Gateway & KYC Console reverse proxy for Staging
# In production, Caddy routes api.logiclinkeg.tech to api-gateway and kyc.logiclinkeg.tech to kyc-reviewer-console.
# Here in staging, Caddy routes :80 (and kyc.* hosts) to ensure full proxy-layer fidelity.
:80 {
    @console host kyc.* kyc.localhost
    handle @console {
        reverse_proxy http://kyc-reviewer-console:8090
    }

    # Mirrors production for the gateway's reviewer paths (/admin, /admin/*),
    # which are never served through the edge. Unlike production,
    # /api/v1/admin/* stays reachable here: the contract and RBAC E2E suites
    # exercise /api/v1/admin/version-config through this edge.
    @admin path /admin /admin/*
    handle @admin {
        respond 404
    }

    handle {
        reverse_proxy https://api-gateway:8080 {
            transport http {
                tls_insecure_skip_verify
            }
        }
    }
}

# Direct port proxy for Reviewer Console in Staging
:8090 {
    reverse_proxy http://kyc-reviewer-console:8090
}
