OTP_AES_KEY=2c6ed89c3365fd0f2a1333deed448c163682149c0985d6c2604c005687a86819
DOCUMENT_SIGNING_SECRET=staging-doc-signing-secret-32-chars-long
DOCUMENT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ALLOW_TEST_PAYMENT_BYPASS=true
