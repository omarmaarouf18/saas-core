# =============================================================================
# Quick Delivery SaaS Platform — Staging Environment Configuration
# =============================================================================
# Fully isolated from production data stores and services.
# Uses identical production service topology, mTLS, and Caddy reverse proxy.
# =============================================================================

# Data Stores (Isolated Staging Database & Redis)
MONGO_INITDB_DATABASE=saas_staging
MONGO_INITDB_ROOT_USERNAME=staging_root
MONGO_INITDB_ROOT_PASSWORD=staging_secret123
AUTH_MONGO_DATABASE=staging_auth_db
USER_MONGO_DATABASE=staging_user_db
CHAT_MONGO_DATABASE=staging_chat_db
NOTIFICATION_MONGO_DATABASE=staging_notification_db
MONGO_URI=mongodb://staging_root:staging_secret123@mongo:27017/?authSource=admin

REDIS_PASSWORD=staging_redis_secret123
REDIS_URI=redis://:staging_redis_secret123@redis:6379

# External Host Exposed Ports (Non-colliding with local dev or production)
STAGING_CADDY_HTTP_PORT=8088
STAGING_CADDY_CONSOLE_PORT=8091
STAGING_MONGO_PORT=27018
STAGING_REDIS_PORT=6381

# Internal Listening Ports (Matching Production Compose)
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=3002
USER_SERVICE_PORT=3003
CHAT_SERVICE_PORT=3001
NOTIFICATION_SERVICE_PORT=3004

# Internal Service Interconnect URLs (Internal Docker Network DNS with mTLS)
AUTH_SERVICE_URL=https://auth-service:3002
USER_SERVICE_URL=https://user-service:3003
CHAT_SERVICE_URL=https://chat-service:3001
NOTIFICATION_SERVICE_URL=https://notification-service:3004

# Environment Flags & Security Tokens
APP_ENV=local
LOG_LEVEL=debug
ALLOWED_ORIGIN=*
JWT_SECRET=NrrYbDqT4bRD/ADvJ5U2VKmLqXr8nk21IRVAbrzVI1mqEhuMhII3IO26PPa4qJtR
