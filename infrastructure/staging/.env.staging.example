# =============================================================================
# Quick Delivery SaaS Platform — Staging Environment Configuration
# =============================================================================
# Fully isolated from production data stores and services.
# Uses identical production service topology, mTLS, and Caddy reverse proxy.
#
# Every value below is a PLACEHOLDER. Copy this file to .env.staging and
# replace every CHANGE_ME_* with a real, unique value before deploying.
#   - CHANGE_ME_64_HEX: `openssl rand -hex 32` (64 hex chars / 32 bytes)
#   - CHANGE_ME_PASSWORD: `openssl rand -base64 24`
# =============================================================================

# Data Stores (Isolated Staging Database & Redis)
MONGO_INITDB_DATABASE=saas_staging
MONGO_INITDB_ROOT_USERNAME=staging_root
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_PASSWORD
AUTH_MONGO_DATABASE=staging_auth_db
USER_MONGO_DATABASE=staging_user_db
CHAT_MONGO_DATABASE=staging_chat_db
NOTIFICATION_MONGO_DATABASE=staging_notification_db
MONGO_URI=mongodb://staging_root:CHANGE_ME_PASSWORD@mongo:27017/?authSource=admin

REDIS_PASSWORD=CHANGE_ME_PASSWORD
REDIS_URI=redis://:CHANGE_ME_PASSWORD@redis:6379

# External Host Exposed Ports (Non-colliding with local dev or production)
STAGING_CADDY_HTTP_PORT=8088
STAGING_CADDY_CONSOLE_PORT=8091
STAGING_MONGO_PORT=27018
STAGING_REDIS_PORT=6381

# Internal Listening Ports (Matching Production Compose)
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=3002
USER_SERVICE_PORT=3003
CHAT_SERVICE_PORT=3001
NOTIFICATION_SERVICE_PORT=3004

# Internal Service Interconnect URLs (Internal Docker Network DNS with mTLS)
AUTH_SERVICE_URL=https://auth-service:3002
USER_SERVICE_URL=https://user-service:3003
CHAT_SERVICE_URL=https://chat-service:3001
NOTIFICATION_SERVICE_URL=https://notification-service:3004
# api-gateway on the internal network (SNI api-gateway, internal CA cert).
# Used by kyc-reviewer-console for GET/PUT /admin/version and by auth-service
# for the GET /admin/audit fan-out. The edge never serves /admin/*.
# Compose defaults it to https://api-gateway:${API_GATEWAY_PORT}.
GATEWAY_INTERNAL_URL=https://api-gateway:8080

# Environment Flags & Security Tokens
APP_ENV=local
LOG_LEVEL=debug
ALLOWED_ORIGIN=*
JWT_SECRET=CHANGE_ME_64_HEX
GATEWAY_SECRET=CHANGE_ME_64_HEX
INTERNAL_SERVICE_TOKEN=CHANGE_ME_64_HEX
# Dedicated admin credential for /api/v1/admin/version-config (X-Admin-Token).
# Must differ from INTERNAL_SERVICE_TOKEN (generate via: `openssl rand -hex 32`).
ADMIN_API_TOKEN=CHANGE_ME_64_HEX
OTP_AES_KEY=CHANGE_ME_64_HEX
DOCUMENT_SIGNING_SECRET=CHANGE_ME_64_HEX
DOCUMENT_ENCRYPTION_KEY=CHANGE_ME_64_HEX
ALLOW_TEST_PAYMENT_BYPASS=true
DIGITAL_PAYMENTS_ENABLED=false # non-COD payments off; production is cash-on-delivery only
RESEND_API_KEY= # e.g. re_123456789
RESEND_FROM_EMAIL= # e.g. Quick Delivery <noreply@yourdomain.com>

# Firebase Cloud Messaging push (optional; empty = push disabled).
# base64 of the service-account key file, one line: base64 -w0 key.json
FCM_SERVICE_ACCOUNT_JSON_B64=
FCM_PROJECT_ID= # default: project_id from the key
KYC_CONSOLE_IMAGE_TAG=latest
