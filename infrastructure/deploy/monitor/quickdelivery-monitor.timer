# quickdelivery-monitor.timer — run quickdelivery-monitor.service every
# 5 minutes (OBS-MIN). Installed by infrastructure/deploy/monitor/install.sh.
# Runbook: docs/runbooks/MONITORING.md.
#
#   systemctl list-timers quickdelivery-monitor.timer

[Unit]
Description=Run the QuickDelivery host health check every 5 minutes

[Timer]
# Whole minutes 0/5/10/…; a run missed while the VM was off is skipped on
# purpose (Persistent invented states during the downtime should not alarm).
OnCalendar=*-*-* *:0/5
# Spread the ping a little so an external monitor load spike never aligns
# every 5-min host in a fleet; the 10-min grace absorbs it.
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
