# =============================================================================
# SaaS Platform — Environment Configuration Template (.env.example)
# =============================================================================
# COPY THIS FILE TO .env.local FOR LOCAL DEV OR .env FOR PRODUCTION
#
# SECURITY NOTICE FOR PRODUCTION DEPLOYMENTS:
# - All secrets marked with "MUST BE CHANGED IN PRODUCTION" must be set to strong,
#   unique, randomly-generated values (e.g. `openssl rand -base64 48`).
# - NEVER reuse secrets between local development and production.
# =============================================================================

# -----------------------------------------------------------------------------
# Database Credentials & URIs
# -----------------------------------------------------------------------------
# [PRODUCTION REQUIREMENT]: Set strong root username & password for MongoDB
MONGO_INITDB_DATABASE=saas_platform
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD= # MUST BE CHANGED IN PRODUCTION (e.g. openssl rand -hex 24)

# Service-Specific Database Isolation (Database per Service)
AUTH_MONGO_DATABASE=auth_db
USER_MONGO_DATABASE=user_db
CHAT_MONGO_DATABASE=chat_db
NOTIFICATION_MONGO_DATABASE=notification_db

# MongoDB Connection String used by microservices
# For Local Dev: mongodb://root:localpassword@mongo:27017/?authSource=admin
# [PRODUCTION REQUIREMENT]: Update with production MONGO_INITDB_ROOT_USERNAME & MONGO_INITDB_ROOT_PASSWORD
MONGO_URI=mongodb://root:localpassword@mongo:27017/?authSource=admin

# [PRODUCTION REQUIREMENT]: Set strong password for Redis
REDIS_PASSWORD= # MUST BE CHANGED IN PRODUCTION (e.g. openssl rand -hex 24)

# Redis Connection String used by microservices (standalone mode)
# For Local Dev: redis://:localpassword@redis:6379
# [PRODUCTION REQUIREMENT]: Update with production REDIS_PASSWORD
REDIS_URI=redis://:localpassword@redis:6379

# Redis Sentinel High Availability Configuration (optional - overrides REDIS_URI if set)
# REDIS_SENTINEL_ADDRS=sentinel1:26379,sentinel2:26379,sentinel3:26379
# REDIS_SENTINEL_MASTER_NAME=mymaster
# REDIS_SENTINEL_PASSWORD= # optional password for Sentinel nodes if configured

# -----------------------------------------------------------------------------
# Internal Port Bindings
# -----------------------------------------------------------------------------
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=3002
USER_SERVICE_PORT=3003
CHAT_SERVICE_PORT=3001
NOTIFICATION_SERVICE_PORT=3004

# -----------------------------------------------------------------------------
# Inter-Service Communication URLs (Internal Docker Network)
# -----------------------------------------------------------------------------
AUTH_SERVICE_URL=https://auth-service:3002
USER_SERVICE_URL=https://user-service:3003
CHAT_SERVICE_URL=https://chat-service:3001
NOTIFICATION_SERVICE_URL=https://notification-service:3004
# api-gateway on the internal network (SNI api-gateway, internal CA cert).
# Used by kyc-reviewer-console for GET/PUT /admin/version and by auth-service
# for the GET /admin/audit fan-out. The edge never serves /admin/*.
# Compose defaults it to https://api-gateway:${API_GATEWAY_PORT}.
GATEWAY_INTERNAL_URL=https://api-gateway:8080

# -----------------------------------------------------------------------------
# Application Environment & Security Tokens
# -----------------------------------------------------------------------------
# Set to 'production' in production deployments ('local' enables dev log output and dev OTP returns)
APP_ENV=local
LOG_LEVEL=info
ALLOWED_ORIGIN=http://localhost:3000
# Seed demo services on first startup (Local development only — set to false or omit in production)
SEED_DEMO_DATA=true
# Non-COD payments (wallet bookings, payouts). Production is cash-on-delivery only: keep false.
# Local/test wallet flows use ALLOW_TEST_PAYMENT_BYPASS instead (refused when APP_ENV=production).
DIGITAL_PAYMENTS_ENABLED=false

# [PRODUCTION REQUIREMENT]: Cryptographic secrets — MUST BE CHANGED IN PRODUCTION
# Generate via: `openssl rand -base64 48`
JWT_SECRET= # MUST BE CHANGED IN PRODUCTION — do not use short or guessable strings
DOCUMENT_SIGNING_SECRET= # MUST BE CHANGED IN PRODUCTION — do not reuse JWT_SECRET
GATEWAY_SECRET= # MUST BE CHANGED IN PRODUCTION — do not use short or guessable strings
INTERNAL_SERVICE_TOKEN= # MUST BE CHANGED IN PRODUCTION — do not use short or guessable strings
# Dedicated admin credential for /api/v1/admin/version-config (X-Admin-Token).
# MUST BE CHANGED IN PRODUCTION and MUST differ from INTERNAL_SERVICE_TOKEN.
ADMIN_API_TOKEN=

# Reviewer console image tag (omarmaarouf18/kyc-reviewer-console).
# In production, MUST be set to an exact SHA tag (NO latest fallback; deploy preflight fails if unset).
KYC_CONSOLE_IMAGE_TAG=

# Reviewer console edge basic auth credentials (Caddy gate on kyc.logiclinkeg.tech).
# Generate hash via: `caddy hash-password` (bcrypt).
# If either variable is empty, Caddy fails closed with HTTP 503.
KYC_CONSOLE_BASIC_AUTH_USER=
KYC_CONSOLE_BASIC_AUTH_HASH=

# AES-256 Key for encrypting OTP codes at rest in MongoDB (64 hex characters / 32 bytes)
# Generate via: `openssl rand -hex 32`
OTP_AES_KEY=

# AES-256 Key for encrypting KYB/KYE documents and service photos at rest on disk
# (64 hex characters / 32 bytes). Local compose passes it to auth-service and user-service.
# The value below is a DEV-ONLY default so local photo upload works out of the box
# (empty = upload/read answer 503 photo_storage_unavailable). It is public: NEVER use it
# in staging or production — generate a real key there with `openssl rand -hex 32`.
DOCUMENT_ENCRYPTION_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef

# -----------------------------------------------------------------------------
# Optional Third-Party Services
# -----------------------------------------------------------------------------
# Resend Email Delivery (Optional for local dev, required for production email OTP delivery)
RESEND_API_KEY= # e.g. re_123456789
RESEND_FROM_EMAIL= # e.g. Quick Delivery <noreply@yourdomain.com>

# Firebase Cloud Messaging Push Notifications (Optional, disabled if unset)
# Preferred: base64 of the service-account key file, one line (`base64 -w0 key.json`).
# Prod/staging compose pass only this one; startup mints one OAuth token and logs
# "push enabled (project X, token ok)" or "push disabled: <reason>", never the key. An invalid value disables push, it does not fail startup.
FCM_SERVICE_ACCOUNT_JSON_B64=
FCM_SERVICE_ACCOUNT_JSON= # Optional, older: the raw service-account JSON (FCM_CREDENTIALS_JSON is an alias)
FCM_PROJECT_ID= # Optional: Firebase project ID (default: project_id from the key)

# AWS CloudWatch Logging (Optional, disabled if empty)
AWS_REGION=us-east-1
CLOUDWATCH_LOG_GROUP=
