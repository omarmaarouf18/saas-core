MONGO_INITDB_DATABASE=saas_platform
MONGO_URI=mongodb://mongo:27017

API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=3002
USER_SERVICE_PORT=3003
CHAT_SERVICE_PORT=3001
NOTIFICATION_SERVICE_PORT=3004

AUTH_SERVICE_URL=https://auth-service:3002
USER_SERVICE_URL=https://user-service:3003
CHAT_SERVICE_URL=https://chat-service:3001
NOTIFICATION_SERVICE_URL=https://notification-service:3004

APP_ENV=local
LOG_LEVEL=debug
ALLOWED_ORIGIN=http://localhost:3000
JWT_SECRET= # generate with `openssl rand -base64 48`, do not use a short or guessable value
GATEWAY_SECRET= # generate with `openssl rand -base64 48`, do not use a short or guessable value
INTERNAL_SERVICE_TOKEN= # generate with `openssl rand -base64 48`, do not use a short or guessable value
OTP_AES_KEY=
AWS_REGION=us-east-1
CLOUDWATCH_LOG_GROUP=

# TLS Configuration (For non-Docker local execution, uncomment and set values)
# TLS_CERT_PATH=infrastructure/certs/auth-service.crt
# TLS_KEY_PATH=infrastructure/certs/auth-service.key
# TLS_CA_PATH=infrastructure/certs/ca.crt

